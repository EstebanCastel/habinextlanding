# Origen canónico. Se usa en el sitemap, en robots y para cerrar el CORS de
# los estáticos, que Vercel sirve por defecto con Access-Control-Allow-Origin: *
NEXT_PUBLIC_SITE_URL=https://habinextlanding.vercel.app

# Links de compra en Luma (uno por tipo de boleta)
NEXT_PUBLIC_LUMA_GENERAL=https://lu.ma/xxxxxxxx
NEXT_PUBLIC_LUMA_VIP=https://lu.ma/xxxxxxxx

# CTA de patrocinadores: correo o formulario
NEXT_PUBLIC_SPONSOR_URL=mailto:habinext@habi.co

# Audiencias de pauta digital. Cada una es opcional: sin la variable no se
# inyecta ningún script y la CSP ya tiene sus dominios permitidos.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Peticiones por IP y por minuto al documento. 0 desactiva el límite.
RATE_LIMIT_PER_MINUTE=90
