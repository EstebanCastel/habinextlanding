# Origen canónico. Se usa en el sitemap, en robots, para armar los links de
# pago y las URL de callback, y para cerrar el CORS de los estáticos.
NEXT_PUBLIC_SITE_URL=https://www.habinext.com

# Registro en Luma (uno por tipo de entrada). Los dos exigen aprobación.
NEXT_PUBLIC_LUMA_GENERAL=https://luma.com/habinext-general
NEXT_PUBLIC_LUMA_VIP=https://luma.com/habinext-vip

# CTA de patrocinadores: correo o formulario
NEXT_PUBLIC_SPONSOR_URL=mailto:habinext@habi.co

# Audiencias de pauta digital. Cada una es opcional: sin la variable no se
# inyecta ningún script y la CSP ya tiene sus dominios permitidos.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTAG_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=

# Peticiones por IP y por minuto al documento. 0 desactiva el límite.
RATE_LIMIT_PER_MINUTE=90


# ─────────────────────────────────────────────────────────────────────────────
# Boletería. Nada de esto lleva el prefijo NEXT_PUBLIC_ a propósito: son
# secretos de servidor y una variable NEXT_PUBLIC_ se hornea en el JavaScript
# que descarga cualquier visitante.
# ─────────────────────────────────────────────────────────────────────────────

# Luma. La API key es de calendario: puede aprobar y rechazar invitados.
LUMA_API_KEY=secret-xxxxxxxxxxxxxxxxxxxxxxxx
# Lo devuelve /v2/webhooks/create y empieza por whsec_. Con él se verifica la
# firma de cada webhook; sin él, /webhook rechaza todo.
LUMA_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
LUMA_EVENT_GENERAL=evt-xxxxxxxxxxxxxxx
LUMA_EVENT_VIP=evt-xxxxxxxxxxxxxxx

# Infobip, línea Colombia. Las plantillas tienen que estar aprobadas por Meta
# y llevan dos variables en este orden: {{1}} primer nombre, {{2}} token.
INFOBIP_BASE_URL=xxxxx.api.infobip.com
INFOBIP_API_KEY=
INFOBIP_LINEA_CO=573009110459
# Las dos llevan el nombre en el ENCABEZADO ({{1}}) y el token en el botón
# «Completar mi pago». El cuerpo va sin marcadores: Infobip rechaza un botón
# con URL variable si el cuerpo tiene alguno, porque comparten numeración.
# La de General suma un botón «Prefiero el VIP».
INFOBIP_TPL_GENERAL_UPSELL=habinext_pago_general_v2_co_sep26
INFOBIP_TPL_VIP=habinext_pago_vip_v2_co_sep26
# Infobip no firma sus callbacks: este token va en la query de la URL del
# webhook (?k=…) y es lo único que separa un reporte real de uno inventado.
INFOBIP_WEBHOOK_TOKEN=

# Cuando el bot no sabe resolver algo, avisa por WhatsApp a este número. Va por
# plantilla y no por texto libre porque quien opera no le escribe a la línea
# todos los días y la ventana de 24 h de Meta suele estar cerrada.
WHATSAPP_ESCALAMIENTO=573043342330
INFOBIP_TPL_ALERTA=habinext_alerta_operador_co_sep26

# Bienvenida de quien entra con un código de invitación: sin link de pago,
# porque su entrada ya salió. {{1}} nombre, {{2}} nombre de la boleta.
INFOBIP_TPL_CORTESIA=habinext_cortesia_co_sep26

# Wompi. Los links de pago son los del comercio; el secreto de eventos sale de
# Wompi → Desarrolladores y es lo que separa un pago real de un JSON inventado.
# Confirmar el pago no aprueba a nadie: eso se hace desde Luma.
WOMPI_LINK_GENERAL=https://checkout.wompi.co/l/xxxxxx
WOMPI_LINK_VIP=https://checkout.wompi.co/l/xxxxxx
WOMPI_EVENTS_SECRET=

# Clave del panel de operación en /admin, que es donde se ve la trazabilidad
# completa de cada persona. Mínimo 16 caracteres.
ADMIN_TOKEN=

# Lo inyecta Vercel al conectar el store privado de Blob. No se pone a mano.
BLOB_READ_WRITE_TOKEN=
